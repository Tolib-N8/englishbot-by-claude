# No API key needed — we use Claude Agent SDK with your local Claude Code login.
# Make sure you have run `claude` once and logged in with your Pro/Max account.
# Optional: pin a specific model. Leave empty to use Claude Code's default.
# CLAUDE_MODEL=claude-sonnet-4-6

# Backend
DATABASE_URL=sqlite+aiosqlite:///./data/data.db
BACKEND_CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Defaults for the single user
USER_LEVEL=A1
USER_NATIVE_LANGUAGE=ru

# Frontend
NEXT_PUBLIC_API_BASE=http://localhost:8000
